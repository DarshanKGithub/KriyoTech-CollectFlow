DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=1
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=kriyopay
POSTGRES_USER=kriyopay
POSTGRES_PASSWORD=kriyopay-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Optional XYZ tile template; default is the OpenStreetMap standard raster service.
NEXT_PUBLIC_MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
# Optional server-side Routes API key. Per-workspace rolling 24-hour budget defaults to 1000 requests.
GOOGLE_MAPS_ROUTES_API_KEY=
GOOGLE_ROUTES_DAILY_REQUEST_BUDGET=1000
# Set a long random secret shared only with GPS providers; sign `${unix_timestamp}.${raw_json_body}` with HMAC-SHA256.
FLEET_GPS_WEBHOOK_SECRET=
# Raw GPS history retention (supported range: 30–3650 days; default: 90).
FLEET_GPS_HISTORY_RETENTION_DAYS=90
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXTAUTH_SECRET=replace-me
DOCUMENT_STORAGE=local
EXTRACTION_PROVIDER=manual
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
WEBHOOK_FERNET_KEY=
DEFAULT_FROM_EMAIL=info@kriyotechlabs.com
# Local dev prints emails to the backend terminal. The EMAIL_* values below
# also support deployments using a different outgoing mail provider.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=info@kriyotechlabs.com
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20
# Platform mail uses Zoho over STARTTLS when both values are set.
# Customer invoice inboxes are connected separately in each workspace.
# Copy the outgoing SMTP host for port 587 from the company mailbox settings.
ZOHO_SMTP_HOST=
ZOHO_SMTP_APP_PASSWORD=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_APPROVED_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
GOOGLE_GMAIL_CLIENT_FILE=../Google_Keys/your-gmail-oauth-client.json
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/integrations/gmail/callback
GOOGLE_SIGNIN_CLIENT_FILE=../Google_Keys/your-google-signin-client.json
GOOGLE_SIGNIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback/

# Razorpay billing (test/live API credentials; never expose the secret in the frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set a webhook secret after configuring a Razorpay webhook in the provider dashboard.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
